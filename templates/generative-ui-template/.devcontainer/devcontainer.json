{
    "name": "Generative UI with AG2",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "secrets": {
        "OPENAI_API_KEY": {
            "description": "Your OpenAI API key for GPT models. Required for running AI agents."
        },
        "ANTHROPIC_API_KEY": {
            "description": "Optional: Your Anthropic API key for Claude models."
        },
        "AZURE_OPENAI_API_KEY": {
            "description": "Optional: Your Azure OpenAI API key."
        },
        "AZURE_API_ENDPOINT": {
            "description": "Optional: Your Azure OpenAI endpoint URL."
        },
        "AZURE_API_VERSION": {
            "description": "Optional: Azure API version (e.g., 2024-02-15-preview)."
        },
        "GEMINI_API_KEY": {
            "description": "Optional: Your Google Gemini API key."
        },
        "TOGETHER_API_KEY": {
            "description": "Optional: Your Together AI API key."
        }
    },
    "remoteEnv": {
        "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
        "AZURE_OPENAI_API_KEY": "${localEnv:AZURE_OPENAI_API_KEY}",
        "AZURE_API_ENDPOINT": "${localEnv:AZURE_API_ENDPOINT}",
        "AZURE_API_VERSION": "${localEnv:AZURE_API_VERSION}",
        "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
        "TOGETHER_API_KEY": "${localEnv:TOGETHER_API_KEY}"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": true,
            "configureZshAsDefaultShell": true,
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "18"
        },
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.11"
        }
    },
    "postCreateCommand": "pip install -r requirements.txt && echo '✅ Dependencies installed! Run: python backend/main.py'",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Generative UI App",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": false,
                "python.linting.flake8Enabled": true,
                "python.formatting.provider": "black",
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pytest_cache": true,
                    "**/*.pyc": true
                }
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-toolsai.jupyter",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "formulahendry.auto-rename-tag",
                "ritwickdey.liveserver"
            ]
        }
    },
    "shutdownAction": "stopContainer"
}
